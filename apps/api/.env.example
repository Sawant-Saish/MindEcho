# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_VERSION=0.1.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lector

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123

# JWT (Phase 1)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Phase 8 workers)
REDIS_URL=redis://localhost:6379

# MinIO / S3 (Phase 4 audio uploads)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lector
S3_SECRET_KEY=lector_dev_secret
S3_BUCKET=lector-audio
S3_REGION=us-east-1

# External providers (Phase 4+)
LLM_PROVIDER=mock
STT_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Feature flags
FEATURE_VOICE_EVAL=true
FEATURE_BILLING=false

# Workers (Phase 8) — set true to run cron jobs inside the API process
ENABLE_WORKERS=false
NOTIFICATION_PROVIDER=mock
